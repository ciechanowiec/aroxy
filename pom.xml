<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness-parent</artifactId>
        <version>1.0.5-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>aroxy</artifactId>
    <version>1.0.3-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>aroxy</name>
    <description>Agent Proxy: a local PII/secret-redacting gateway for coding agents</description>
    <url>https://github.com/ciechanowiec/aroxy</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT-0</name>
            <url>https://spdx.org/licenses/MIT-0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Herman Ciechanowiec</name>
            <email>herman@ciechanowiec.eu</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/ciechanowiec/aroxy.git</connection>
        <developerConnection>scm:git:git@github.com:ciechanowiec/aroxy.git</developerConnection>
        <url>https://github.com/ciechanowiec/aroxy</url>
    </scm>

    <properties>
        <!-- Process-boundary classes are exercised outside the JVM observed by JaCoCo. -->
        <airness.coverage.excluded.classes>eu.ciechanowiec.aroxy.cli.Aroxy,eu.ciechanowiec.aroxy.cli.*Command,eu.ciechanowiec.aroxy.cli.DaemonEntry,eu.ciechanowiec.aroxy.cli.Version,eu.ciechanowiec.aroxy.daemon.Launcher*,eu.ciechanowiec.aroxy.daemon.LaunchCommand,eu.ciechanowiec.aroxy.daemon.DaemonProcess,eu.ciechanowiec.aroxy.daemon.Daemon,eu.ciechanowiec.aroxy.daemon.Home,eu.ciechanowiec.aroxy.fs.RestrictedDir</airness.coverage.excluded.classes>
        <!-- The package Airness analyzes as project-owned code. -->
        <airness.package.root>eu.ciechanowiec.aroxy</airness.package.root>
        <!-- Vendored tools and themes contain the typography they detect or belong to another tool. -->
        <airness.typography.excludes>.vale/,.idea/,.docs/themes/</airness.typography.excludes>

        <!-- Application dependencies. Harness dependency versions come from Airness. -->
        <bouncycastle.provider.version>1.85.2</bouncycastle.provider.version>
        <slf4j-api.version>2.0.18</slf4j-api.version>
        <picocli.version>4.7.7</picocli.version>
        <aircompressor.version>2.0.3</aircompressor.version>
        <bouncycastle.pkix.version>1.85</bouncycastle.pkix.version>
        <jetty.version>12.1.12</jetty.version>
        <org-json.version>20260719</org-json.version>
        <tinylog.version>2.7.0</tinylog.version>

        <main.class>eu.ciechanowiec.aroxy.cli.Aroxy</main.class>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Bouncy Castle publishes provider patches independently from its PKIX artifact. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.provider.version}</version>
            </dependency>
            <!-- Keep Jetty and tinylog on Aroxy's declared SLF4J API version. -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j-api.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <!-- Codex requests compressed with zstd must be inflated before obfuscation. -->
            <groupId>io.airlift</groupId>
            <artifactId>aircompressor</artifactId>
            <version>${aircompressor.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <!-- Copilot's process-local authority issues certificates without spawning keytool. -->
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.pkix.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.http2</groupId>
            <artifactId>jetty-http2-client</artifactId>
            <version>${jetty.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.http2</groupId>
            <artifactId>jetty-http2-client-transport</artifactId>
            <version>${jetty.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.http2</groupId>
            <artifactId>jetty-http2-server</artifactId>
            <version>${jetty.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-client</artifactId>
            <version>${jetty.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-http</artifactId>
            <version>${jetty.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-io</artifactId>
            <version>${jetty.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>${jetty.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-util</artifactId>
            <version>${jetty.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${org-json.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.tinylog</groupId>
            <artifactId>slf4j-tinylog</artifactId>
            <version>${tinylog.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.tinylog</groupId>
            <artifactId>tinylog-impl</artifactId>
            <version>${tinylog.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <!-- version.txt is filtered so ${project.version} remains the version source of truth. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>version.txt</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>version.txt</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <!-- The flat uber-jar gives the daemon a real CodeSource path for self-relaunch. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!--
                                            OSGi bundle metadata, which several dependencies of one
                                            vendor family each carry, so shading them reports an
                                            overlap. This artifact is an executable jar and is never
                                            loaded as a bundle, so the directory cannot affect it at
                                            any version. Excluding it keeps the overlap warning
                                            meaning that two jars disagreed about something that
                                            matters.
                                        -->
                                        <exclude>META-INF/versions/*/OSGI-INF/**</exclude>
                                        <exclude>OSGI-INF/**</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/LICENSE.txt</exclude>
                                        <exclude>META-INF/LICENSE.md</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/NOTICE.txt</exclude>
                                        <exclude>META-INF/NOTICE.md</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <failOnWarnings>${airness.enforce}</failOnWarnings>
                    <doclint>all,-missing</doclint>
                </configuration>
            </plugin>
            <!-- Mockito and logback are aroxy-specific bans, not family-wide Airness policy. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-aroxy-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.mockito:*</exclude>
                                        <exclude>ch.qos.logback:*</exclude>
                                    </excludes>
                                    <message>Tests use real objects, and logging is tinylog via SLF4J</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Documentation remains project-owned and joins Airness's slow profile. -->
            <id>extended</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>lint-docs</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>scripts/lint-docs.sh</argument>
                                        <argument>README.adoc</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
