#!/usr/bin/env sh
# Validates the pending commit message against the governance policy (Conventional Commits header,
# subject quality, body for a non-trivial change, no AI-agent attribution). Uses the compiled
# governance classes; if they are missing it compiles them once. Runs the same rules the whole-history
# check enforces, so a message that passes here passes CI.
set -eu
cd "$(git rev-parse --show-toplevel)"

classes="target/test-classes"
entry="$classes/eu/ciechanowiec/aroxy/governance/CommitMessageEntry.class"
if [ ! -f "$entry" ]; then
    echo "commit-msg: compiling governance checks (first run)..." >&2
    mvn -q test-compile -Drewrite.skip=true >/dev/null
fi
java -cp "$classes" eu.ciechanowiec.aroxy.governance.CommitMessageEntry "$1"
