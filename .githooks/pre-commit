#!/usr/bin/env sh
# Fast local guard before a commit is recorded: compile and run the fast test subset, which includes
# the always-on governance checks (typography of tracked files, instruction-file references). The full
# verification (static analysis, per-class coverage, secret scan, whole-history checks) runs on
# pre-push and in CI.
set -eu
cd "$(git rev-parse --show-toplevel)"
mvn -q test -Drewrite.skip=true
